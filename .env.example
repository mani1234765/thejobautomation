# JobPilot configuration. Copy to `.env` (repo root or backend/) and fill in what you need.
# Every integration is optional — missing credentials show as "Requires setup" in the app.

# ── Core ──────────────────────────────────────────────────────────────────────────────────────
JOBPILOT_ENV=development                     # development | test | production
# PostgreSQL in production; omit to use SQLite at backend/data/jobpilot.db
# DATABASE_URL=postgresql+psycopg://jobpilot:password@localhost:5432/jobpilot
# Required in production — generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JOBPILOT_SECRET_KEY=
# Fernet key for encrypting integration credentials at rest (required in production):
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
JOBPILOT_ENCRYPTION_KEY=
JOBPILOT_PUBLIC_APP_URL=http://localhost:3000
JOBPILOT_COOKIE_SECURE=false                 # must be true in production (HTTPS)
JOBPILOT_STORAGE_DIR=                        # defaults to backend/data/files
JOBPILOT_MAX_UPLOAD_MB=8
# Shared rate-limit store; required in production (multiple API instances).
JOBPILOT_REDIS_URL=                          # e.g. redis://localhost:6379/0

# ── AI provider (provider-neutral) ────────────────────────────────────────────────────────────
JOBPILOT_LLM_PROVIDER=none                   # anthropic | openai | none
JOBPILOT_LLM_MODEL=                          # e.g. claude-opus-5-5, or an OpenAI-compatible model id
JOBPILOT_LLM_API_KEY=
JOBPILOT_LLM_BASE_URL=                       # OpenAI-compatible endpoints only (Azure, local gateways…)
JOBPILOT_LLM_EFFORT=medium                   # Anthropic effort: low | medium | high | xhigh | max
JOBPILOT_LLM_MAX_OUTPUT_TOKENS=16000
JOBPILOT_LLM_DAILY_BUDGET_USD=2.0            # per user, rolling 24h; unpriced models are charged at the top rate
JOBPILOT_LLM_ALLOWED_MODELS=                 # comma-separated models users may pick as an override

# ── Gmail (Google OAuth client, "Web application", redirect URI below) ───────────────────────
#   Authorized redirect URI: ${JOBPILOT_PUBLIC_APP_URL}/api/v1/integrations/gmail/callback
JOBPILOT_GOOGLE_CLIENT_ID=
JOBPILOT_GOOGLE_CLIENT_SECRET=

# ── WhatsApp Business Cloud API ───────────────────────────────────────────────────────────────
JOBPILOT_WHATSAPP_ACCESS_TOKEN=
JOBPILOT_WHATSAPP_PHONE_NUMBER_ID=

# ── Frontend ──────────────────────────────────────────────────────────────────────────────────
JOBPILOT_API_ORIGIN=http://127.0.0.1:8000    # where Next.js proxies /api/*

# ── MCP server (mcp-server/) ──────────────────────────────────────────────────────────────────
JOBPILOT_API_URL=http://localhost:8000
JOBPILOT_API_TOKEN=                          # create in Settings → Security → API tokens
